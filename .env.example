ALPACA_API_KEY=replace-me
ALPACA_SECRET_KEY=replace-me
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Safe by default. Set false only after checking the dashboard and paper account.
DRY_RUN=true
ALLOW_SHORTING=false
ALLOW_LIVE_TRADING=false

TRADE_CAPITAL_CZK=250
TAKE_PROFIT_PERCENT=10
STOP_LOSS_PERCENT=7
MAX_HOLD_DAYS=30

# Signal freshness and scraping load.
SIGNAL_MAX_AGE_HOURS=36
FINVIZ_MAX_PAGES=3
INSIDER_SCAN_INTERVAL_MINUTES=5
POSITION_CHECK_INTERVAL_MINUTES=2
MARKET_OPEN_POLL_SECONDS=30
MARKET_CLOSED_POLL_SECONDS=300

# Portfolio and queue guardrails.
MAX_OPEN_POSITIONS=10
MAX_NEW_ENTRIES_PER_DAY=10
MAX_GROSS_EXPOSURE_USD=2500
MAX_QUEUE_ATTEMPTS=5
QUEUE_RETRY_BASE_SECONDS=60
QUEUE_EXPIRY_HOURS=24
ORDER_FILL_TIMEOUT_SECONDS=15

# Informational same-day/swing tracking. Broker controls remain authoritative.
DAY_TRADE_WARNING_LIMIT=3
DAY_TRADE_WINDOW_BUSINESS_DAYS=5

# Account-equity comparison with a buy-and-hold benchmark.
BENCHMARK_SYMBOL=SPY
PERFORMANCE_LOOKBACK_DAYS=365
PERFORMANCE_REFRESH_MINUTES=15

STATE_DIR=/data
LOG_DIR=/data/logs
SQLITE_DB_PATH=/data/insider_trading.sqlite3

MONITORING_ENABLED=true
MONITORING_HOST=0.0.0.0
MONITORING_PORT=8080
# Optional. When set, use /?token=... or Authorization: Bearer ...
MONITORING_TOKEN=
